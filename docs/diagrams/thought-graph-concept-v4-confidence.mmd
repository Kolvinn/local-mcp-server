---
config: {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "themeVariables": {
        "primaryColor": "#4a90d9",
        "primaryTextColor": "#ffffff",
        "primaryBorderColor": "#2c6fb6",
        "secondaryColor": "#f5a623",
        "secondaryTextColor": "#111111",
        "secondaryBorderColor": "#d4891a",
        "tertiaryColor": "#7ed321",
        "tertiaryTextColor": "#111111",
        "tertiaryBorderColor": "#5ea81a",
        "lineColor": "#00bcd4",
        "errorColor": "#e74c3c",
        "errorTextColor": "#ffffff",
        "errorBorderColor": "#c0392b",
        "memoryColor": "#8e44ad",
        "memoryTextColor": "#ffffff",
        "memoryBorderColor": "#6c3483"
    }
}
---
flowchart TD
    User(["USER"])

    User -->|"input"| Classify{"Input type?"}

    subgraph PreStage["PRE-STAGE: Input Classification"]
        direction TB

        subgraph SpecificID["Specific (by ID)"]
            direction TB
            S1["User: 'continue task-42'
            or 'work on goal-auth'"]
            S2["Qdrant lookup by ID:
            → task-42 found
            → parent concept: 'Add auth'
            → sibling goals: 'login', 'token-verify'
            → 3 open questions"]
            S3["Orchestrator surfaces:
            'Is this related to task-42?
            I found nodes for task-42,
            goal-auth, goal-login.
            Query the mind map now?'"]
            S1 --> S2 --> S3
        end

        subgraph General["General (no ID)"]
            direction TB
            G1["User: 'let's keep building
            the auth system'"]
            G2["Qdrant semantic search:
            'auth system' →
            matches concept 'Add auth'
            (score 0.91)
            + 'API middleware' (0.74)"]
            G3["Orchestrator surfaces:
            'This looks related to
            concept 'Add auth'.
            I have 2 sub-goals and
            3 open questions. Continue?'"]
            G1 --> G2 --> G3
        end

        subgraph DirectOrder["Direct Order"]
            direction TB
            DO1["User: 'rename getCwd
            to getCurrentWorkingDirectory
            across the project'"]
            DO2{"Conflicts with
            known facts?"}
            DO2 -->|"no conflict"| DO3["Execute directly:
            spawn implementer"]
            DO2 -->|"conflict or
            no capability"| DO4["Ask user to confirm:
            'This conflicts with X.
            Proceed anyway?'"]
        end
    end

    Classify -->|"specific ID"| S1
    Classify -->|"general"| G1
    Classify -->|"direct order"| DO1

    S3 --> ConfirmScope{{"USER:
    correct scope?"}}
    G3 --> ConfirmScope

    ConfirmScope -->|"yes, proceed"| Orch["ORCHESTRATOR"]
    ConfirmScope -->|"no, refine"| User

    DO3 --> Orch
    DO4 -.->|"confirm?"| User

    subgraph DecisionLog["Decision Log (append-only → LangSmith traces)"]
        DL[("Decision Log")]
        DL1["what: concept + agent + action"]
        DL2["when: session + timestamp"]
        DL3["outcome: success / rework / user-override"]
    end

    subgraph FutureNote["Future: Training Agent adjusts confidence weights
    based on semantically similar questions + outcomes"]
    end

    subgraph Confidence["Confidence Engine"]
        direction LR
        CBar["0.0 ▓▓▓▓▓▓▓▓░░░░ 0.65 1.0"]
        CExplain["f(coverage, question count, domain spread)"]
    end

    Orch -->|"query: similar past concepts?"| DL

    subgraph Stages["Staged Expansion (confidence proposes, user gates)"]
        direction TB

        subgraph S1s["STAGE 1: WIDE"]
            direction TB
            W1["Place root :Concept node"]
            W2["Expand: for each concept,
            identify blocking :Question nodes"]
            W3["For each question,
            generate :Option branches"]
            W4["Compute confidence:
            coverage + question count + domain spread"]
            W5["Present wide map to user"]
            W1 --> W2 --> W3 --> W4 --> W5
        end

        subgraph S2s["STAGE 2: DEEP"]
            direction TB
            D1["User selects preferred
            :Option per question
            (or 'explore all')"]
            D2{":Option type?"}
            D2 -->|"delegate"| SpawnAgent["Spawn Specialist Agent
            with scoped context"]
            D2 -->|"ask user"| ProbeUser(["Probe User"])
            D2 -->|"research"| ExploreDocs["Explorer: codebase/docs"]
            D3["Findings become new nodes
            or resolve the question"]
            D4["Record decision + outcome"]
            D1 --> D2
            SpawnAgent --> D3
            ProbeUser --> D3
            ExploreDocs --> D3
            D3 --> D4
        end

        W5 -->|"user gate: approve wide map?"| Gate1{{"USER GATE"}}
        Gate1 -->|"approve"| D1
        Gate1 -->|"expand more"| W2
        D4 -->|"re-assess confidence"| CBar
        D4 -->|"unresolved questions remain"| W2
        D4 -->|"all resolved"| Synthesize
    end

    subgraph Graph["Thought Graph (GraphRAG + Qdrant)"]
        direction TB
        C1[":Concept
        'Integrate Qdrant into
        GraphRAG via Memgraph'"]
        Q1[":Question
        'How does Qdrant
        integrate with GraphRAGs?'"]
        Q2[":Question
        'What Memgraph features
        support vector search?'"]
        ON1[":OptionNode
        resolve 'Qdrant+GraphRAG'"]
        O1a[":Option
        'Delegate to Explorer
        (qdrant skills)'"]
        O1b[":Option
        'Ask user for
        architecture preference'"]
        O1c[":Option
        'Research existing
        Qdrant GraphRAG patterns'"]
        ON2[":OptionNode
        resolve 'Memgraph vectors'"]
        O2a[":Option
        'Delegate to Explorer
        (memgraph-graph-rag skill)'"]
        O2b[":Option
        'Read Memgraph docs
        via context7'"]
        S[":Static
        'nomic-embed-text 768d
        already deployed'"]

        C1 -->|"RELIES_ON"| Q1
        C1 -->|"RELIES_ON"| Q2
        C1 -->|"INFORMS"| S
        Q1 -->|"DEPENDS_ON"| ON1
        Q2 -->|"DEPENDS_ON"| ON2
        ON1 -->|"HAS_OPTION"| O1a
        ON1 -->|"HAS_OPTION"| O1b
        ON1 -->|"HAS_OPTION"| O1c
        ON2 -->|"HAS_OPTION"| O2a
        ON2 -->|"HAS_OPTION"| O2b
    end

    Orch -->|"query by ID"| Graph
    Orch -->|"semantic search"| Graph
    S2 -->|"reads"| Graph
    G2 -->|"reads"| Graph
    W2 -->|"populate"| Graph
    W4 -->|"read coverage"| Graph
    D3 -->|"mutate"| Graph
    D4 -->|"append"| DL

    ProbeUser -.->|"clarification"| User
    SpawnAgent -->|"record decision"| DL

    Synthesize["SYNTHESIZE → GATE"]
    Synthesize -->|"record outcome"| DL
    Synthesize --> Gate2{{"USER GATE"}}

    style PreStage fill:#1a1a2e,stroke:#00bcd4,stroke-width:2px,color:#e0e0e0
    style SpecificID fill:#1e1e36,stroke:#4a90d9,stroke-width:1px,color:#e0e0e0
    style General fill:#1e1e36,stroke:#4a90d9,stroke-width:1px,color:#e0e0e0
    style DirectOrder fill:#1e1e36,stroke:#f5a623,stroke-width:1px,color:#e0e0e0
    style DecisionLog fill:#1a1a2e,stroke:#8e44ad,stroke-width:2px,color:#e0e0e0
    style FutureNote fill:#1e1e36,stroke:#8e44ad,stroke-width:1px,color:#aaaaaa,stroke-dasharray: 5 5
    style Confidence fill:#1a1a2e,stroke:#f5a623,stroke-width:2px,color:#e0e0e0
    style Stages fill:#1a1a2e,stroke:#4a90d9,stroke-width:2px,color:#e0e0e0
    style S1s fill:#1e1e36,stroke:#4a90d9,stroke-width:1px,color:#e0e0e0
    style S2s fill:#1e1e36,stroke:#8e44ad,stroke-width:1px,color:#e0e0e0
    style Graph fill:#1a1a2e,stroke:#7ed321,stroke-width:2px,color:#e0e0e0

    style Orch fill:#4a90d9,stroke:#2c6fb6,color:#fff
    style DL fill:#95a5a6,stroke:#7f8c8d,color:#fff
    style CBar fill:#f5a623,stroke:#d4891a,color:#111
    style Classify fill:#00bcd4,stroke:#0097a7,color:#fff
    style S3 fill:#00bcd4,stroke:#0097a7,color:#fff
    style G3 fill:#00bcd4,stroke:#0097a7,color:#fff
    style ConfirmScope fill:#e74c3c,stroke:#c0392b,color:#fff

    style C1 fill:#4a90d9,stroke:#2c6fb6,color:#fff
    style Q1 fill:#e74c3c,stroke:#c0392b,color:#fff
    style Q2 fill:#e74c3c,stroke:#c0392b,color:#fff
    style ON1 fill:#f5a623,stroke:#d4891a,color:#111
    style ON2 fill:#f5a623,stroke:#d4891a,color:#111
    style O1a fill:#f5a623,stroke:#d4891a,color:#111
    style O1b fill:#f5a623,stroke:#d4891a,color:#111
    style O1c fill:#f5a623,stroke:#d4891a,color:#111
    style O2a fill:#f5a623,stroke:#d4891a,color:#111
    style O2b fill:#f5a623,stroke:#d4891a,color:#111
    style S fill:#7ed321,stroke:#5ea81a,color:#111

    style W5 fill:#e74c3c,stroke:#c0392b,color:#fff
    style D1 fill:#e74c3c,stroke:#c0392b,color:#fff
    style SpawnAgent fill:#8e44ad,stroke:#6c3483,color:#fff
    style ProbeUser fill:#e74c3c,stroke:#c0392b,color:#fff
    style ExploreDocs fill:#4a90d9,stroke:#2c6fb6,color:#fff
    style Synthesize fill:#7ed321,stroke:#5ea81a,color:#111
    style Gate1 fill:#e74c3c,stroke:#c0392b,color:#fff
    style Gate2 fill:#e74c3c,stroke:#c0392b,color:#fff
