---
config: {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "themeVariables": {
        "primaryColor": "#4a90d9",
        "primaryTextColor": "#ffffff",
        "primaryBorderColor": "#2c6fb6",
        "secondaryColor": "#f5a623",
        "secondaryTextColor": "#ffffff",
        "secondaryBorderColor": "#d4891a",
        "tertiaryColor": "#7ed321",
        "tertiaryTextColor": "#ffffff",
        "tertiaryBorderColor": "#5ea81a",
        "lineColor": "#00bcd4",
        "errorColor": "#e74c3c",
        "errorTextColor": "#ffffff",
        "errorBorderColor": "#c0392b",
        "neutralColor": "#95a5a6",
        "neutralTextColor": "#ffffff",
        "neutralBorderColor": "#7f8c8d",
        "memoryColor": "#8e44ad",
        "memoryTextColor": "#ffffff",
        "memoryBorderColor": "#6c3483"
    }
}
---
flowchart TD
    subgraph MemoryManager ["Memory Manager"]
        direction TB
        MM["Memory Manager\nGoal Tracker +\nProject State"]
        GoalGraph[("Goal Graph\nUser Goals ↔\nProject Goals")]
        PhaseTrack[("Phase Tracker\nCurrent Phase:\nGoal→Options→Spec\n→Code→Review")]
        ContextIndex[("Context Index\nProject Notes\nDecisions / Bugs\nExploration Cache")]
        SessionState[("Session State\nHandoff / Ratings\nPending Items")]

        MM --- GoalGraph
        MM --- PhaseTrack
        MM --- ContextIndex
        MM --- SessionState
    end

    subgraph OrchestratorFlow ["Orchestrator Thinking Loop"]
        direction TB
        Start(["User Input"])

        Start --> Orient["Orient:\nWhere are we\nin the project?"]
        Orient -..->|"query phase +\ngoal hierarchy"| MM

        Orient --> Specificity{"Specificity\nAnalysis"}
        Specificity -->|"Specific &\nWell-scoped"| Decompose["Decompose into\nSub-Chunks"]
        Specificity -->|"Vague &\nOpen-ended"| ProbeUser["Probe: Goal?\nConstraints?\nScope?"]
        ProbeUser --> WaitUser1(["Await User\nRefinement"])
        WaitUser1 -.->|"New / refined input"| Orient

        Decompose --> NextChunk{"Next Chunk\nPending?"}
        NextChunk -->|"Yes"| AlignGoal{"Aligns with\nProject Goal?"}
        AlignGoal -..->|"check goal\nhierarchy"| MM
        AlignGoal -->|"Yes"| ComplexEval
        AlignGoal -->|"No - new goal"| RegisterGoal["Register new goal\nin hierarchy"]
        RegisterGoal -..->|"update goal graph"| MM
        RegisterGoal --> ComplexEval

        ComplexEval{"Complexity\nAssessment"}
        ComplexEval -->|"Trivial /\nSingle-step"| AntiDelegate{"Overhead to\ndelegate?"}
        AntiDelegate -->|"Yes - just do it"| ExecuteSimple["Execute Directly"]
        AntiDelegate -->|"No"| GapCheck
        ComplexEval -->|"Moderate /\nNeeds context"| GapCheck
        ComplexEval -->|"Complex /\nMulti-domain"| SpawnCheck{"Spawn\nSpecialist?"}

        SpawnCheck -->|"Yes"| SpawnSpecialist["Spawn Specialist\nwith domain skills"]
        SpawnCheck -->|"No - overkill"| GapCheck["What Context\nis Missing?"]
        SpawnSpecialist --> WaitSpec["Await Specialist\nSummary"]

        GapCheck -->|"File / Code"| ExplorerRun["Explorer Agent:\nfilesystem dep search"]
        GapCheck -->|"Semantic /\nMemory / Docs"| MemoryRun["Memory Agent:\nGraphRAG + Qdrant"]
        GapCheck -->|"Both"| ParallelRun["Spawn Both\nin Parallel"]

        ExplorerRun --> ContextBuf["Context Buffer"]
        MemoryRun --> ContextBuf
        ParallelRun --> ContextBuf

        ContextBuf -..->|"cache findings +\nupdate context index"| MM

        ContextBuf --> DeepGuard{"Progressive\nDeepening Guard"}
        DeepGuard -->|"Too deep too early"| StepBack["Step Back:\nBroaden scope"]
        DeepGuard -->|"Sufficiently broad"| Sufficiency{"Sufficient\nContext?"}

        StepBack --> UserCheckpoint(["Present Findings\nAsk Direction"])
        UserCheckpoint -.->|"User redirects"| Orient

        Sufficiency -->|"No - more gaps"| GapCheck
        Sufficiency -->|"Yes"| WaitSpec
        WaitSpec --> Synthesize["Synthesize &\nReduce Results"]
        ExecuteSimple --> Synthesize

        Aggregate["Aggregate Chunk\nResults"] --> Synthesize

        Synthesize --> GateEntry{{"Gate Pipeline"}}

        GateEntry -->|"Gate 1"| G1["APPROACH:\n2-3 options +\ntrade-offs"]
        G1 --> AwaitG1(["User approves\napproach?"])
        AwaitG1 -->|"No - redirect"| Orient
        AwaitG1 -->|"Yes"| RecordG1["Record decision"]
        RecordG1 -..->|"log to decisions.md"| MM
        RecordG1 --> G2["SPEC:\nPseudocode spec\nprepared"]

        G2 --> AwaitG2(["User approves\nspec?"])
        AwaitG2 -->|"No - revise"| Orient
        AwaitG2 -->|"Yes"| RecordG2["Record spec"]
        RecordG2 -..->|"log approved spec"| MM
        RecordG2 --> G3["CODE:\nImplementation\n+ test results"]

        G3 --> AwaitG3(["User approves\ncode?"])
        AwaitG3 -->|"No - fix"| G3
        AwaitG3 -->|"Yes"| RecordG3["Record code"]
        RecordG3 -..->|"log implementation"| MM
        RecordG3 --> G4["REVIEW:\nVerified +\nreviewed"]

        G4 --> AwaitG4(["User signs off?"])
        AwaitG4 -->|"No - rework"| G3
        AwaitG4 -->|"Yes"| RecordG4["Record review"]
        RecordG4 -..->|"log review + update\nissues.md phase tracker"| MM
        RecordG4 --> Deliver(["Deliver to User"])

        Deliver --> LoopCheck{"Session\nContinues?"}
        LoopCheck -->|"User refines /\nnew task"| Orient
        LoopCheck -->|"New session +\nshared context"| Orient
        LoopCheck -->|"Session ends"| Handoff(["Write handoff.md\nRate session"])
    end

    Handoff -..->|"persist session state +\nupdate ratings"| MM

    style MemoryManager fill:#f4ecf7,stroke:#8e44ad,stroke-width:2px
    style OrchestratorFlow fill:#f8f9fa,stroke:#cccccc,stroke-width:1px
    style MM fill:#8e44ad,stroke:#6c3483,color:#fff
    style GoalGraph fill:#d2b4de,stroke:#8e44ad,color:#333
    style PhaseTrack fill:#d2b4de,stroke:#8e44ad,color:#333
    style ContextIndex fill:#d2b4de,stroke:#8e44ad,color:#333
    style SessionState fill:#d2b4de,stroke:#8e44ad,color:#333
    style Start fill:#4a90d9,stroke:#2c6fb6,color:#fff
    style Deliver fill:#7ed321,stroke:#5ea81a,color:#fff
    style Handoff fill:#95a5a6,stroke:#7f8c8d,color:#fff
    style GateEntry fill:#f5a623,stroke:#d4891a,color:#fff
    style Synthesize fill:#f5a623,stroke:#d4891a,color:#fff
    style G1 fill:#fff8e1,stroke:#f5a623,color:#333
    style G2 fill:#fff8e1,stroke:#f5a623,color:#333
    style G3 fill:#fff8e1,stroke:#f5a623,color:#333
    style G4 fill:#fff8e1,stroke:#f5a623,color:#333
    style AwaitG1 fill:#e74c3c,stroke:#c0392b,color:#fff
    style AwaitG2 fill:#e74c3c,stroke:#c0392b,color:#fff
    style AwaitG3 fill:#e74c3c,stroke:#c0392b,color:#fff
    style AwaitG4 fill:#e74c3c,stroke:#c0392b,color:#fff
