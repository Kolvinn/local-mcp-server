---
config: {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "themeVariables": {
        "primaryColor": "#4a90d9",
        "primaryTextColor": "#ffffff",
        "primaryBorderColor": "#2c6fb6",
        "secondaryColor": "#f5a623",
        "secondaryTextColor": "#111111",
        "secondaryBorderColor": "#d4891a",
        "tertiaryColor": "#7ed321",
        "tertiaryTextColor": "#111111",
        "tertiaryBorderColor": "#5ea81a",
        "lineColor": "#00bcd4",
        "errorColor": "#e74c3c",
        "errorTextColor": "#ffffff",
        "errorBorderColor": "#c0392b",
        "memoryColor": "#8e44ad",
        "memoryTextColor": "#ffffff",
        "memoryBorderColor": "#6c3483"
    }
}
---
flowchart TD
    User(["USER"])

    subgraph DecisionLog["Decision Log (append-only)"]
        DL[("Decision Log<br/>what + when + outcome")]
    end

    Orch["ORCHESTRATOR"]
    User -->|"input / answer"| Orch

    subgraph Stages["Staged Orchestration"]
        direction TB

        subgraph S1["STAGE 1: WIDE"]
            direction TB
            W1["Decompose goal tree<br/>breadth-first"]
            W2["Place :Question nodes<br/>at unresolved leaves"]
            W3["Compute: is coverage<br/>satisfactory?"]
            W1 --> W2 --> W3
        end

        subgraph S2["STAGE 2: ASSESS"]
            direction TB
            A1["Evaluate question<br/>distribution + gaps"]
            A2["Check: all domains<br/>covered?"]
            A3["Present wide map<br/>to user for gate"]
            A1 --> A2 --> A3
        end

        subgraph S3["STAGE 3: DEEP"]
            direction TB
            D1["For each :Question leaf:<br/>resolve or spawn"]
            D2["Route: User-answerable?<br/>→ probe. Otherwise → agent"]
            D3["Injected findings<br/>become new graph nodes"]
            D4["Record decision:<br/>what + agent + outcome"]
            D1 --> D2 --> D3 --> D4
        end

        W3 -->|"gate: user approves<br/>wide map"| A1
        A3 -->|"gate: user approves<br/>deep dive"| D1
        W3 -->|"insufficient coverage"| W1
    end

    Orch -->|"start"| W1

    subgraph Graph["Thought Graph (GraphRAG + Qdrant)"]
        direction TB
        G[":Goal<br/>root"]
        G --> SG1[":Goal<br/>sub"]
        G --> SG2[":Goal<br/>sub"]
        SG1 --> Q1[":Question"]
        SG2 --> Q2[":Question"]
        Q1 -.->|"resolved by"| D1g[":Decision"]
    end

    W2 -->|"populate"| Graph
    A1 -->|"evaluate"| Graph
    D3 -->|"mutate"| Graph

    D2 -->|"user route"| AskUser(["Probe User"])
    D2 -->|"agent route"| SpawnAgent["Spawn Specialist"]
    AskUser -.->|"clarification"| User
    SpawnAgent -->|"findings"| Graph
    D4 -->|"append"| DL

    A3 -->|"present"| User
    D4 --> Synthesize["SYNTHESIZE → GATE"]
    Synthesize -->|"record outcome"| DL

    style DecisionLog fill:#1a1a2e,stroke:#8e44ad,stroke-width:2px,color:#e0e0e0
    style Stages fill:#1a1a2e,stroke:#4a90d9,stroke-width:2px,color:#e0e0e0
    style S1 fill:#1e1e36,stroke:#4a90d9,stroke-width:1px,color:#e0e0e0
    style S2 fill:#1e1e36,stroke:#f5a623,stroke-width:1px,color:#e0e0e0
    style S3 fill:#1e1e36,stroke:#8e44ad,stroke-width:1px,color:#e0e0e0
    style Graph fill:#1a1a2e,stroke:#7ed321,stroke-width:2px,color:#e0e0e0
    style Orch fill:#4a90d9,stroke:#2c6fb6,color:#fff
    style DL fill:#95a5a6,stroke:#7f8c8d,color:#fff
    style G fill:#7ed321,stroke:#5ea81a,color:#111
    style Q1 fill:#e74c3c,stroke:#c0392b,color:#fff
    style Q2 fill:#e74c3c,stroke:#c0392b,color:#fff
    style Synthesize fill:#7ed321,stroke:#5ea81a,color:#111
    style AskUser fill:#e74c3c,stroke:#c0392b,color:#fff
    style SpawnAgent fill:#8e44ad,stroke:#6c3483,color:#fff
