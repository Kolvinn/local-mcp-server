{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcp_proxy_server": {
      "type": "remote",
      "url": "http://0.0.0.0:8000/mcp"
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Orchestrator — Sole user contact. Owns goals, workflow direction, delegation, and approval gates. Never designs, codes, explores, or verifies. Spawns agent variations (Thinker, Architect, Implementer, Auditor, Explorer) with per-task skill/context injection.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "bash": {
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "bunx skills *": "allow",
          "tree *": "allow",
          "curl *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "read": "ask",
        "write": {
          "docs/project_notes/*": "ask",
          "docs/plans/*": "ask",
          "docs/context/*": "ask",
          "docs/learnings/*": "ask",
          ".opencode/prompts/*": "ask",
          "SESSION_HANDOFF.md": "ask",
          "task_plan.md": "ask",
          "progress.md": "ask",
          "findings.md": "ask",
          "*": "ask"
        },
        "webfetch": "ask",
        "websearch": "ask",
        "glob": "allow",
        "skill": "ask",
        "task": {
          "system_thinker": "allow",
          "implementer": "allow",
          "auditor": "allow",
          "explorer": "allow",
          "explore": "deny",
          "*": "ask"
        }
      }
    },
    "system_thinker": {
      "description": "System Thinker — Spawnable template for domain design. Loads skills per delegation. Produces design options (wide) and pseudocode specs (deep). Records learnings. Never writes production code or talks to users. Variations: strategic_thinker, rag_thinker, architect_thinker.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/system_thinker.md}",
      "permission": {
        "bash": {
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "echo *": "allow",
          "vi *": "ask",
          "tree *": "allow",
          "tee *": "ask",
          "*": "ask"
        },
        "read": "deny",
        "write": "deny",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "ask",
        "edit": "ask",
        "task": {
          "explorer": "allow",
          "*": "ask"
        }
      }
    },
    "implementer": {
      "description": "Implementer — Code translator. Reads approved pseudocode specs, writes production code. Translates, does not design. Language-agnostic — skills loaded per task. Variations: python_implementer, infra_implementer.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/implementer.md}",
      "permission": {
        "bash": {
          "git status": "allow",
          "git diff *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "*": "ask"
        },
        "read": "allow",
        "write": "ask",
        "edit": "ask",
        "skill": "ask",
        "webfetch": "deny",
        "websearch": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    },
    "auditor": {
      "description": "Auditor — Code audit & verification specialist. Examines code across 5 dimensions: spec compliance, best practices, system integration, adversarial testing, and produces structured findings. Never fixes code. Language-agnostic. Variation: code_auditor.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/auditor.md}",
      "permission": {
        "bash": {
          "pytest *": "allow",
          "python *": "ask",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "wc *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git status": "allow",
          "*": "deny"
        },
        "read": "allow",
        "write": {
          "docs/learnings/*": "allow",
          "src/tests/*": "ask",
          "*": "deny"
        },
        "edit": "deny",
        "glob": "allow",
        "skill": "ask",
        "grep": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "explorer": {
      "description": "Explorer — Read-only codebase scout and structural analyst. File search, dependency graphs, call chains, import maps. Writes findings to docs/exploration/. Returns only 'complete' or 'error' to caller. Variations: codebase_explorer, dependency_explorer.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/explorer.md}",
      "permission": {
        "bash": {
          "git status": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "glob": "allow",
        "read": "allow",
        "skill": "ask",
        "write": {
          "docs/exploration/*": "allow",
          "*": "ask"
        },
        "edit": "deny",
        "task": "deny"
      }
    }
  }
}