{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "description": "Orchestrator — Sole user contact. Owns goals, workflow direction, delegation, and approval gates. Never designs, codes, explores, or reviews. Spawns System Thinker (design), Implementer (code), Reviewer (verify), Explorer (scout).",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "bash": {
          "head *": "allow",
          "wc *": "allow",
          "cat *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "*": "ask"
        },
        "read": "allow",
        "write": {
          "docs/project_notes/*": "allow",
          "docs/ratings/*": "allow",
          "*": "ask"
        },
        "webfetch": "ask",
        "websearch": "ask",
        "task": {
          "system_thinker": "allow",
          "implementer": "allow",
          "reviewer": "allow",
          "explorer": "allow",
          "*": "deny"
        }
      }
    },
    "system_thinker": {
      "description": "System Thinker — Spawnable template for domain design. Loads skills per delegation. Produces design options (wide) and pseudocode specs (deep). Records learnings. Never writes production code or talks to users.",
      "mode": "all",
      "model": "opencode-go/kimi-k2.5",
      "prompt": "{file:./prompts/system_thinker.md}",
      "permission": {
        "bash": {
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "*": "deny"
        },
        "read": "allow",
        "write": {
          "docs/briefs/*": "allow",
          "docs/specs/*": "allow",
          "docs/learnings/*": "allow",
          "*": "deny"
        },
        "glob": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "explorer": "allow",
          "*": "deny"
        }
      }
    },
    "implementer": {
      "description": "Implementer — Code translator. Reads approved pseudocode specs, writes production code, runs tests. Translates, does not design.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.5",
      "prompt": "{file:./prompts/implementer.md}",
      "permission": {
        "bash": {
          "python3 *": "allow",
          "pip *": "allow",
          "pytest *": "allow",
          "uv *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "*": "ask"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "reviewer": {
      "description": "Reviewer — Read-only code verification. Compares implementation to pseudocode spec. Priority-based findings: Blocker, Major, Minor, Suggestion.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.5",
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "bash": {
          "rg *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "find * -type f*": "allow",
          "wc *": "allow",
          "pytest *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "*": "deny"
        },
        "edit": "deny",
        "write": {
          "docs/reviews/*": "allow",
          "*": "deny"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "task": {
          "*": "deny"
        }
      }
    },
    "explorer": {
      "description": "Explorer — Read-only codebase scout and structural analyst. File search, dependency graphs, call chains, import maps. Writes findings to docs/exploration/. Returns only 'complete' or 'error' to caller.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/explorer.md}",
      "permission": {
        "bash": {
          "git status": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "glob": "allow",
        "read": "allow",
        "write": {
          "docs/exploration/*": "allow",
          "*": "deny"
        },
        "edit": "deny",
        "task": {
          "*": "deny"
        }
      }
    }
  }
}
